    <!-- Onboarding legal -->
    <string name="onboard_connect_title">CONECTAR T-EMBED</string>
    <string name="onboard_connect_body">Conecta el CC1101 Plus por USB OTG.\nLa app detectará el dispositivo automáticamente.\nTambién puedes usar WiFi (BruceNet) o BLE.</string>
    <string name="onboard_capture_title">CAPTURAR SEÑAL</string>
    <string name="onboard_capture_body">Ve a RF → CAPTURAR RAW.\nEl CC1101 escuchará 433.92 MHz.\nLas señales se guardan con GPS si activas ubicación.</string>
    <string name="onboard_library_title">BIBLIOTECA &amp; REPLAY</string>
    <string name="onboard_library_body">Todas las señales van a la biblioteca.\nPuedes retransmitir, exportar .sub\ny comparar protocolos decodificados.</string>
    <string name="onboard_legal_title">USO LEGAL</string>
    <string name="onboard_legal_body">EMBED SUITE es para investigación autorizada.\nTú eres responsable del cumplimiento de leyes locales.\nNo interferir con comunicaciones ajenas ni retransmitir señales sin permiso.\nEl wardriving y la TX RF pueden estar regulados en tu país.</string>
    <string name="onboard_legal_accept">Acepto la responsabilidad legal del uso de RF, WiFi/BLE y GPS</string>
    <string name="onboard_next">SIGUIENTE</string>
    <string name="onboard_start">COMENZAR</string>
    <string name="wireless_war_legal_title">WAR-DRIVE — aviso legal</string>
    <string name="wireless_war_legal_body">El escaneo WiFi/BLE con GPS guarda redes y ubicación en el teléfono. Úsalo solo en entornos autorizados. No es un ataque; eres responsable del cumplimiento local.</string>
    <string name="wireless_war_legal_accept">Activar WAR-DRIVE</string>

