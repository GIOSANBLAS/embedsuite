+#pragma once
+
+#include <Arduino.h>
+
+/**
+ * Power Manager — gestión de energía para la simbiosis EmbedSuite.
+ *
+ * OJO: el T-Embed se usa principalmente por USB CDC (TEH-Link). Un light-sleep
+ * profundo tumba TinyUSB y cortaría el enlace con Android, así que el modo de
+ * ahorro es un "doze" seguro: CPU a 80 MHz + pantalla apagada vía powerSave,
+ * manteniendo el stack USB vivo. El wake es instantáneo al llegar un comando.
+ */
+namespace xibalba {
+namespace power {
+
+enum class PowerMode : uint8_t { ACTIVE = 0, DOZE = 1 };
+
+void begin();
+
+/** Marca actividad (cada comando TEH-Link/evento de input la renueva). */
+void activity();
+
+/** Llamar periódicamente desde la tarea serial/TEH-Link. */
+void update();
+
+PowerMode mode();
+
+/** ms desde la última actividad registrada. */
+uint32_t idleMs();
+
+/** Timeout de doze configurable (default 5 min). 0 desactiva el doze. */
+void setIdleTimeoutMs(uint32_t ms);
+uint32_t idleTimeoutMs();
+
+} // namespace power
+} // namespace xibalba
