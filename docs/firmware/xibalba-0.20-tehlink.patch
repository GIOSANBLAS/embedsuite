+#pragma once
+
+#include <Arduino.h>
+
+/**
+ * Audio Feedback — beeps semánticos para el speaker NS4168 del T-Embed.
+ *
+ * Envuelve `_tone()` de modules/others/audio (respeta bruceConfig.soundEnabled)
+ * con eventos con nombre para que la app y los módulos no repitan frecuencias
+ * mágicas. Android puede disparar un beep arbitrario con `audio.beep`.
+ */
+namespace xibalba {
+namespace audio {
+
+void begin();
+
+/** Beep arbitrario (Hz / ms). duration 0 = tono continuo hasta stop(). */
+void beep(uint16_t freqHz, uint16_t durationMs);
+
+void stop();
+
+// Feedback semántico
+void ok();          // operación correcta
+void error();       // error de operación
+void cardFound();   // tarjeta NFC detectada
+void packetFound(); // paquete RF capturado
+void scanDone();    // barrido completado
+
+} // namespace audio
+} // namespace xibalba
