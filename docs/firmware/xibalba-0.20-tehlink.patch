new file mode 100644
index 0000000..81116a1
--- /dev/null
+++ b/src/core/teh_link/teh_events.cpp
@@ -0,0 +1,42 @@
+#include "teh_events.h"
+
+#include "core/time_sync.h"
+#include <freertos/FreeRTOS.h>
+#include <freertos/semphr.h>
+#include <globals.h>
+
+static SemaphoreHandle_t s_serial_mtx = nullptr;
+
+void teh_link_events_begin() {
+    if (!s_serial_mtx) s_serial_mtx = xSemaphoreCreateMutex();
+}
+
+bool teh_link_serial_try_lock() {
+    if (!s_serial_mtx) return true;
+    return xSemaphoreTake(s_serial_mtx, pdMS_TO_TICKS(5)) == pdTRUE;
+}
+
+void teh_link_serial_unlock() {
+    if (s_serial_mtx) xSemaphoreGive(s_serial_mtx);
+}
+
+void teh_link_emit_event(const char *event, JsonObjectConst data) {
+    if (!event || !*event) return;
+    if (!teh_link_serial_try_lock()) return; // línea en curso: se descarta
+
+    JsonDocument root;
+    root["type"] = "event";
+    root["event"] = event;
+    root["ts"] = (uint64_t)xibalba::time_sync::eventTimestampMs();
+    if (!data.isNull()) root["data"] = data;
+
+    String out;
+    serializeJson(root, out);
+    serialDevice->println(out);
+    serialDevice->flush();
+    teh_link_serial_unlock();
+}
+
+void teh_link_emit_event(const char *event) {
+    teh_link_emit_event(event, JsonObjectConst());
+}
