-    options.emplace_back("Setup pin", []() { setAction(ACTION_SETUP_PIN); });
-    options.emplace_back("Close menu", []() { setAction(ACTION_CLOSE); });
-    options.emplace_back("Main menu", []() { setAction(ACTION_MAIN_MENU); });
-
-    selectedAction = ACTION_CLOSE;
