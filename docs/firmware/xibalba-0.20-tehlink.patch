+++ b/src/core/teh_link/teh_events.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <Arduino.h>
+#include <ArduinoJson.h>
+
+/**
+ * TEH-Link Events — streaming NDJSON firmware → EmbedSuite.
+ *
+ * Además del par comando/respuesta, el firmware emite líneas no solicitadas:
+ *   {"type":"event","event":"rf.scan.sample","ts":<epoch_ms>,"data":{...}}
+ *
+ * `ts` usa el reloj sincronizado con Android (time_sync) para que las series
+ * RF+GPS de EmbedSuite compartan eje temporal con el teléfono.
+ *
+ * El hilo serie está protegido por un mutex: las respuestas a comandos y los
+ * eventos nunca se entrelazan a mitad de línea.
+ */
+void teh_link_events_begin();
+
