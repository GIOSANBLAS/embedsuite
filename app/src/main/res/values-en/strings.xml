    <string name="onboard_connect_title">CONNECT T-EMBED</string>
    <string name="onboard_connect_body">Connect the T-Embed CC1101 Plus via USB OTG.\nThe app uses TEH-Link (Xibalba firmware) for full device control.\nLong-press the side button (GPIO6) before first pairing.\n\nWiFi/BLE: phone-side features; Xibalba OTA always via USB.</string>
    <string name="onboard_capture_title">CAPTURE SIGNAL</string>
    <string name="onboard_capture_body">Go to RF → CAPTURE RAW.\nThe CC1101 will listen on 433.92 MHz.\nSignals are saved with GPS if location is on.</string>
    <string name="onboard_library_title">LIBRARY &amp; REPLAY</string>
    <string name="onboard_library_body">All signals go to the library.\nYou can retransmit, export .sub\nand compare decoded protocols.</string>
    <string name="onboard_legal_title">LEGAL USE</string>
    <string name="onboard_legal_body">EMBED SUITE is for authorized research.\nYou are responsible for local law compliance.\nDo not interfere with others\' communications or retransmit without permission.\nWardriving and RF TX may be regulated in your country.</string>
    <string name="onboard_legal_accept">I accept legal responsibility for RF, WiFi/BLE and GPS use</string>
    <string name="onboard_next">NEXT</string>
    <string name="onboard_start">START</string>
    <string name="wireless_war_legal_title">WAR-DRIVE — legal notice</string>
    <string name="wireless_war_legal_body">WiFi/BLE scanning with GPS stores networks and location on the phone. Use only in authorized environments. Not an attack; you are responsible for local compliance.</string>
    <string name="wireless_war_legal_accept">Enable WAR-DRIVE</string>

