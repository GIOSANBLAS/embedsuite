+#pragma once
+
+#include <Arduino.h>
+
+/**
+ * Language — multi-idioma ES/EN para Xibalba (NVS-backed).
+ *
+ * La UI TFT heredada de Bruce está en español sin acentos (limitación de las
+ * fuentes). Este módulo fija la base para i18n: preferencia persistente y
+ * tabla de cadenas para los mensajes que genera el firmware hacia EmbedSuite
+ * (TEH-Link) y las pantallas nuevas. EmbedSuite envía `system.set_lang`.
+ */
+namespace xibalba {
+namespace lang {
+
+enum class Lang : uint8_t { ES = 0, EN = 1 };
+
+void begin();
+
+Lang current();
+const char *currentTag(); // "es" | "en"
+
+/** Persiste en NVS y devuelve false si el tag no es válido. */
+bool setByTag(const String &tag);
+
+// Claves de mensajes firmware → app / pantalla
+enum class Key : uint8_t {
+    Ready = 0,
+    WaitingCard,
+    CardDetected,
+    Scanning,
+    JammerActive,
+    SdReady,
+    SdMissing,
+    ErrorGeneric,
+};
+
+const char *str(Key key);
+
+} // namespace lang
+} // namespace xibalba
