-static String bufferToHexStr(const byte *buf, int len, const char *sep = ":") {
-    String s;
-    for (int i = 0; i < len; i++) {
-        if (buf[i] < 0x10) s += '0';
-        s += String(buf[i], HEX);
-        if (i < len - 1) s += sep;
-    }
-    s.toUpperCase();
-    return s;
-}
