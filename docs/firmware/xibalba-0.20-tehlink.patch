diff --git a/src/core/power_manager.cpp b/src/core/power_manager.cpp
new file mode 100644
index 0000000..c1ed09f
--- /dev/null
+++ b/src/core/power_manager.cpp
@@ -0,0 +1,59 @@
+#include "power_manager.h"
+
+#include "core/display.h"
+#include "core/powerSave.h"
+#include <globals.h>
+
+namespace xibalba {
+namespace power {
+
+static const uint32_t DEFAULT_IDLE_TIMEOUT_MS = 5UL * 60UL * 1000UL; // 5 min
+
+static PowerMode s_mode = PowerMode::ACTIVE;
+static uint32_t s_last_activity_ms = 0;
+static uint32_t s_idle_timeout_ms = DEFAULT_IDLE_TIMEOUT_MS;
+
+void begin() {
+    s_mode = PowerMode::ACTIVE;
+    s_last_activity_ms = millis();
+}
+
+void activity() {
+    s_last_activity_ms = millis();
+    if (s_mode == PowerMode::DOZE) {
+        // Despertar: restaurar CPU y pantalla (powerSave ya gestiona brillo)
+        setCpuFrequencyMhz(CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ);
+        if (isScreenOff) {
+            isScreenOff = false;
+            wakeUpScreen();
+        }
+        previousMillis = millis(); // reinicia el dimmer de powerSave
+        s_mode = PowerMode::ACTIVE;
+        Serial.println("[POWER] ACTIVE (actividad TEH-Link)");
+    }
+}
+
+void update() {
+    if (s_idle_timeout_ms == 0) return; // doze desactivado
+    if (s_mode != PowerMode::ACTIVE) return;
+
+    uint32_t idle = millis() - s_last_activity_ms;
+    if (idle < s_idle_timeout_ms) return;
+
+    // No dormir si hay una operación RF/NFC larga en curso (las tareas TEH
+    // renuevan actividad) ni si la pantalla ya está en su propio ciclo.
+    s_mode = PowerMode::DOZE;
+    setCpuFrequencyMhz(80);
+    Serial.println("[POWER] DOZE (idle > timeout) — USB CDC sigue vivo");
+}
+
+PowerMode mode() { return s_mode; }
+
+uint32_t idleMs() { return millis() - s_last_activity_ms; }
+
+void setIdleTimeoutMs(uint32_t ms) { s_idle_timeout_ms = ms; }
+
+uint32_t idleTimeoutMs() { return s_idle_timeout_ms; }
+
+} // namespace power
+} // namespace xibalba
