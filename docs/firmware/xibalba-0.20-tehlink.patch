diff --git a/src/core/teh_link/teh_rf.cpp b/src/core/teh_link/teh_rf.cpp
new file mode 100644
index 0000000..3b8dbac
--- /dev/null
+++ b/src/core/teh_link/teh_rf.cpp
@@ -0,0 +1,279 @@
+#include "teh_rf.h"
+
+#include "core/audio_feedback.h"
+#include "core/power_manager.h"
+#include "modules/rf/rf_utils.h"
+#include "teh_events.h"
+#include <ELECHOUSE_CC1101_SRC_DRV.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <globals.h>
+
+#ifndef TFT_MOSI
+#define TFT_MOSI -1
+#endif
+
+// ---- Límites CC1101 ----
+static const float FREQ_MIN_MHZ = 300.0f;
+static const float FREQ_MAX_MHZ = 928.0f;
+
+// Cutoff de seguridad del jammer (máximo absoluto 5 min aunque la app pida más)
+static const uint32_t JAMMER_DEFAULT_MAX_MS = 30000;
+static const uint32_t JAMMER_HARD_MAX_MS = 300000;
+
+// Tabla PA del driver SmartRC-CC1101 (dBm soportados)
+static const int PA_DBM_TABLE[] = {-30, -20, -15, -10, -6, 0, 5, 7, 10, 11, 12};
+
+static int pa_for_dbm(int reqDbm) {
+    int best = PA_DBM_TABLE[0];
+    for (size_t i = 0; i < sizeof(PA_DBM_TABLE) / sizeof(PA_DBM_TABLE[0]); i++) {
+        if (PA_DBM_TABLE[i] <= reqDbm) best = PA_DBM_TABLE[i];
+    }
+    return best;
+}
+
+// Tras cada transacción SPI del CC1101 en T-Embed el bus se comparte con el TFT;
+// hay que tocar el display para que el bus quede consistente (ver rf_waterfall).
+static inline void spi_bus_quirk_tembed() {
+    if (bruceConfigPins.CC1101_bus.mosi == TFT_MOSI) tft.drawPixel(0, 0, 0);
+}
+
+// ============================================================================
+// RF SCANNER — barrido RSSI con streaming de muestras
+// ============================================================================
+// OJO: structs dentro del namespace teh_rf — ir_jammer.h define un
+// ::JammerState global y colisionaría por ODR en el link LTO.
+namespace teh_rf {
+
+struct ScanState {
+    volatile bool active = false;
+    float freqStart = 433.0f;
+    float freqEnd = 435.0f;
+    float step = 0.1f;
+    int rssiThreshold = -100;
+    uint32_t dwellMs = 10;
+    uint32_t samples = 0;
+    uint32_t sweeps = 0;
+    float maxFreq = 0.0f;
+    int maxRssi = -127;
+    TaskHandle_t task = nullptr;
+};
+static ScanState s_scan;
+
+static void rf_scan_task(void *) {
+    if (!initRfModule("rx", s_scan.freqStart)) {
+        teh_link_emit_event("rf.scan.error");
+        s_scan.active = false;
+        s_scan.task = nullptr;
+        vTaskDelete(nullptr);
+        return;
+    }
+    ELECHOUSE_cc1101.setRxBW(200); // 200 kHz — buen compromiso sensibilidad/velocidad
+
+    while (s_scan.active) {
+        for (float f = s_scan.freqStart; f <= s_scan.freqEnd && s_scan.active; f += s_scan.step) {
+            setMHZ(f);
+            spi_bus_quirk_tembed();
+            delayMicroseconds(150);
+
+            int rssi = ELECHOUSE_cc1101.getRssi();
+            spi_bus_quirk_tembed();
+
+            s_scan.samples++;
+            if (rssi > s_scan.maxRssi) {
+                s_scan.maxRssi = rssi;
+                s_scan.maxFreq = f;
+            }
+
+            if (rssi >= s_scan.rssiThreshold) {
+                JsonDocument ev;
+                JsonObject d = ev.to<JsonObject>();
+                d["freq"] = (double)f;
+                d["rssi"] = rssi;
+                teh_link_emit_event("rf.scan.sample", d);
+            }
+
+            // Renueva actividad para que el power manager no duerma a mitad de barrido
+            if ((s_scan.samples & 0x3F) == 0) xibalba::power::activity();
+            vTaskDelay(pdMS_TO_TICKS(s_scan.dwellMs));
+        }
+        s_scan.sweeps++;
+    }
+
+    deinitRfModule();
+    teh_link_emit_event("rf.scan.stopped");
+    xibalba::audio::scanDone();
+    s_scan.task = nullptr;
+    vTaskDelete(nullptr);
+}
+
+bool scan_start(JsonObjectConst params, String &err) {
+    if (busy()) {
+        err = "rf_busy";
+        return false;
+    }
+    float fStart = params["freq_start"] | 433.0f;
+    float fEnd = params["freq_end"] | 435.0f;
+    float step = params["step"] | 0.1f;
+
+    if (fStart < FREQ_MIN_MHZ || fEnd > FREQ_MAX_MHZ || fStart >= fEnd) {
+        err = "freq_out_of_range";
+        return false;
+    }
+    if (step <= 0.001f || step > (fEnd - fStart)) {
+        err = "invalid_step";
+        return false;
+    }
+
+    s_scan.freqStart = fStart;
+    s_scan.freqEnd = fEnd;
+    s_scan.step = step;
+    s_scan.rssiThreshold = params["rssi_threshold"] | -100;
+    s_scan.dwellMs = (uint32_t)constrain(params["dwell_ms"] | 10, 1, 1000);
+    s_scan.samples = 0;
+    s_scan.sweeps = 0;
+    s_scan.maxRssi = -127;
+    s_scan.active = true;
+
+    if (xTaskCreatePinnedToCore(rf_scan_task, "teh_rfscan", 4096, nullptr, 1, &s_scan.task, 0) !=
+        pdPASS) {
+        s_scan.active = false;
+        err = "task_create_failed";
+        return false;
+    }
+    teh_link_emit_event("rf.scan.started");
+    return true;
+}
+
+void scan_stop() { s_scan.active = false; }
+
+void scan_fill_status(JsonObject data) {
+    data["running"] = (bool)s_scan.active;
+    data["state"] = s_scan.active ? "scanning" : "idle";
+    data["freq_start"] = s_scan.freqStart;
+    data["freq_end"] = s_scan.freqEnd;
+    data["step"] = s_scan.step;
+    data["rssi_threshold"] = s_scan.rssiThreshold;
+    data["samples"] = s_scan.samples;
+    data["sweeps"] = s_scan.sweeps;
+    data["max_freq"] = s_scan.maxFreq;
+    data["max_rssi"] = s_scan.maxRssi;
+}
+
+// ============================================================================
+// RF JAMMER — TX headless con cutoff de seguridad
+// ============================================================================
+struct JammerState {  // teh_rf::JammerState (distinto del ::JammerState de IR)
+    volatile bool active = false;
+    float freq = 433.92f;
+    int powerDbm = 12;
+    bool burst = false;
+    uint32_t burstOnMs = 50;
+    uint32_t burstOffMs = 100;
+    uint32_t maxMs = JAMMER_DEFAULT_MAX_MS;
+    uint32_t startedMs = 0;
+    uint32_t pulses = 0;
+    TaskHandle_t task = nullptr;
+};
+static JammerState s_jam;
+
+static void rf_jammer_task(void *) {
+    int txPin = bruceConfigPins.rfTx;
+    if (!initRfModule("tx", s_jam.freq)) {
+        teh_link_emit_event("rf.jammer.error");
+        s_jam.active = false;
+        s_jam.task = nullptr;
+        vTaskDelete(nullptr);
+        return;
+    }
+    if (bruceConfigPins.rfModule == CC1101_SPI_MODULE) {
+        txPin = bruceConfigPins.CC1101_bus.io0;
+        pinMode(txPin, OUTPUT);
+        ELECHOUSE_cc1101.setPA(pa_for_dbm(s_jam.powerDbm));
+        ELECHOUSE_cc1101.SetTx();
+    } else {
+        pinMode(txPin, OUTPUT);
+    }
+
+    s_jam.startedMs = millis();
+    s_jam.pulses = 0;
+
+    while (s_jam.active) {
+        if (millis() - s_jam.startedMs >= s_jam.maxMs) break; // cutoff de seguridad
+
+        if (s_jam.burst) {
+            digitalWrite(txPin, HIGH);
+            s_jam.pulses++;
+            vTaskDelay(pdMS_TO_TICKS(s_jam.burstOnMs));
+            digitalWrite(txPin, LOW);
+            vTaskDelay(pdMS_TO_TICKS(s_jam.burstOffMs));
+        } else {
+            // Portadora continua: HIGH sostenido, cediendo cada 50 ms para el WDT
+            digitalWrite(txPin, HIGH);
+            s_jam.pulses++;
+            vTaskDelay(pdMS_TO_TICKS(50));
+        }
+        xibalba::power::activity();
+    }
+
+    digitalWrite(txPin, LOW);
+    deinitRfModule();
+    s_jam.active = false;
+    teh_link_emit_event("rf.jammer.stopped");
+    s_jam.task = nullptr;
+    vTaskDelete(nullptr);
+}
+
+bool jammer_start(JsonObjectConst params, String &err) {
+    if (busy()) {
+        err = "rf_busy";
+        return false;
+    }
+    float freq = params["freq"] | 433.92f;
+    if (freq < FREQ_MIN_MHZ || freq > FREQ_MAX_MHZ) {
+        err = "freq_out_of_range";
+        return false;
+    }
+
+    String mode = params["mode"] | "continuous";
+    s_jam.freq = freq;
+    s_jam.powerDbm = constrain(params["power"] | 12, -30, 12);
+    s_jam.burst = (mode == "burst");
+    s_jam.burstOnMs = (uint32_t)constrain(params["burst_on_ms"] | 50, 1, 5000);
+    s_jam.burstOffMs = (uint32_t)constrain(params["burst_interval"] | 100, 1, 5000);
+    uint32_t maxSec = (uint32_t)(params["max_seconds"] | (JAMMER_DEFAULT_MAX_MS / 1000));
+    s_jam.maxMs = min(maxSec * 1000UL, JAMMER_HARD_MAX_MS);
+    s_jam.active = true;
+
+    if (xTaskCreatePinnedToCore(rf_jammer_task, "teh_rfjam", 4096, nullptr, 1, &s_jam.task, 0) !=
+        pdPASS) {
+        s_jam.active = false;
+        err = "task_create_failed";
+        return false;
+    }
+
+    JsonDocument ev;
+    JsonObject d = ev.to<JsonObject>();
+    d["freq"] = s_jam.freq;
+    d["mode"] = mode;
+    d["max_ms"] = s_jam.maxMs;
+    teh_link_emit_event("rf.jammer.started", d);
+    return true;
+}
+
+void jammer_stop() { s_jam.active = false; }
+
+void jammer_fill_status(JsonObject data) {
+    data["running"] = (bool)s_jam.active;
+    data["state"] = s_jam.active ? "jamming" : "idle";
+    data["freq"] = s_jam.freq;
+    data["power_dbm"] = s_jam.powerDbm;
+    data["mode"] = s_jam.burst ? "burst" : "continuous";
+    data["pulses"] = s_jam.pulses;
+    data["max_ms"] = s_jam.maxMs;
+    if (s_jam.active) data["elapsed_ms"] = millis() - s_jam.startedMs;
+}
+
+bool busy() { return s_scan.active || s_jam.active; }
+
+} // namespace teh_rf
