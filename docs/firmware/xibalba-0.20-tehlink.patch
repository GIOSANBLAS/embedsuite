diff --git a/src/core/teh_link/teh_nfc.cpp b/src/core/teh_link/teh_nfc.cpp
new file mode 100644
index 0000000..243223e
--- /dev/null
+++ b/src/core/teh_link/teh_nfc.cpp
@@ -0,0 +1,192 @@
+#include "teh_nfc.h"
+
+#include "core/audio_feedback.h"
+#include "core/language.h"
+#include "core/power_manager.h"
+#include "teh_events.h"
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+
+#if !defined(LITE_VERSION) && !defined(DISABLE_INTERPRETER)
+#define TEH_NFC_HEADLESS 1
+#include "modules/rfid/tag_o_matic.h"
+#endif
+
+namespace teh_nfc {
+
+static volatile bool s_running = false;
+static uint32_t s_cards = 0;
+static String s_last_uid;
+static TaskHandle_t s_task = nullptr;
+
+bool reader_running() { return s_running; }
+
+#ifdef TEH_NFC_HEADLESS
+
+static void fill_card(JsonObject d, TagOMatic &reader) {
+    RFIDInterface *rfid = reader.getRFIDInterface();
+    if (!rfid) return;
+    d["uid"] = rfid->printableUID.uid;
+    d["type"] = rfid->printableUID.picc_type;
+    d["sak"] = rfid->printableUID.sak;
+    d["atqa"] = rfid->printableUID.atqa;
+}
+
+static void nfc_reader_task(void *pvParameters) {
+    uint32_t timeoutMs = (uint32_t)(uintptr_t)pvParameters;
+    uint32_t started = millis();
+
+    {
+        TagOMatic reader(true); // headless: sin UI, inicializa el módulo PN532
+        String seenUid;
+
+        while (s_running) {
+            if (timeoutMs > 0 && (millis() - started) >= timeoutMs) break;
+
+            // Ventana corta por iteración para poder cortar con reader_stop
+            String uid = reader.read_uid_headless(1);
+            if (uid.length() > 0 && uid != seenUid) {
+                seenUid = uid;
+                s_cards++;
+                s_last_uid = uid;
+
+                JsonDocument ev;
+                JsonObject d = ev.to<JsonObject>();
+                d["uid"] = uid;
+                RFIDInterface *rfid = reader.getRFIDInterface();
+                if (rfid) {
+                    d["type"] = rfid->printableUID.picc_type;
+                    d["sak"] = rfid->printableUID.sak;
+                    d["atqa"] = rfid->printableUID.atqa;
+                }
+                teh_link_emit_event("nfc.card.detected", d);
+                xibalba::audio::cardFound();
+            } else if (uid.length() == 0) {
+                seenUid = ""; // tarjeta retirada → puede re-detectarse
+            }
+
+            xibalba::power::activity();
+            vTaskDelay(pdMS_TO_TICKS(50));
+        }
+    }
+
+    s_running = false;
+    teh_link_emit_event("nfc.reader.stopped");
+    s_task = nullptr;
+    vTaskDelete(nullptr);
+}
+
+bool reader_start(JsonObjectConst params, String &err) {
+    if (s_running) {
+        err = "reader_already_running";
+        return false;
+    }
+    uint32_t timeoutSec = (uint32_t)constrain(params["timeout"] | 60, 0, 600);
+    s_cards = 0;
+    s_last_uid = "";
+    s_running = true;
+    if (xTaskCreatePinnedToCore(
+            nfc_reader_task, "teh_nfc", 8192, (void *)(uintptr_t)(timeoutSec * 1000UL), 1,
+            &s_task, 0
+        ) != pdPASS) {
+        s_running = false;
+        err = "task_create_failed";
+        return false;
+    }
+    teh_link_emit_event("nfc.reader.started");
+    return true;
+}
+
+void reader_stop() { s_running = false; }
+
+void fill_status(JsonObject data) {
+    data["running"] = (bool)s_running;
+    data["state"] = s_running ? "reading" : "idle";
+    data["ready"] = true;
+    data["cards"] = s_cards;
+    data["last_uid"] = s_last_uid;
+    data["message"] = xibalba::lang::str(
+        s_running ? xibalba::lang::Key::WaitingCard : xibalba::lang::Key::Ready
+    );
+}
+
+bool read_once(JsonObject data, int timeoutSec) {
+    TagOMatic reader(true);
+    String uid = reader.read_uid_headless(constrain(timeoutSec, 1, 60));
+    if (uid.length() == 0) return false;
+    data["uid"] = uid;
+    RFIDInterface *rfid = reader.getRFIDInterface();
+    if (rfid) {
+        data["type"] = rfid->printableUID.picc_type;
+        data["sak"] = rfid->printableUID.sak;
+        data["atqa"] = rfid->printableUID.atqa;
+    }
+    s_last_uid = uid;
+    s_cards++;
+    xibalba::audio::cardFound();
+    return true;
+}
+
+bool write_ndef_text(const String &text, int timeoutSec, String &err) {
+    if (text.length() == 0 || text.length() > 130) {
+        err = "invalid_data";
+        return false;
+    }
+    TagOMatic reader(true);
+    RFIDInterface *rfid = reader.getRFIDInterface();
+    if (!rfid) {
+        err = "nfc_hw_unavailable";
+        return false;
+    }
+
+    // NDEF Text Record (RTD "T", lang "en") — igual que build_ndef_text_payload
+    rfid->ndefMessage.payloadType = RFIDInterface::NDEF_TEXT;
+    rfid->ndefMessage.payload[0] = 0x02;
+    rfid->ndefMessage.payload[1] = 0x65; // 'e'
+    rfid->ndefMessage.payload[2] = 0x6E; // 'n'
+    size_t i = 0;
+    for (; i < (size_t)text.length() && (i + 3) < sizeof(rfid->ndefMessage.payload); i++) {
+        rfid->ndefMessage.payload[i + 3] = (byte)text.charAt(i);
+    }
+    rfid->ndefMessage.payloadSize = i + 3;
+    rfid->ndefMessage.messageSize = rfid->ndefMessage.payloadSize + 4;
+
+    uint32_t started = millis();
+    while ((millis() - started) < (uint32_t)timeoutSec * 1000UL) {
+        int rc = rfid->write_ndef();
+        if (rc == RFIDInterface::SUCCESS) {
+            xibalba::audio::ok();
+            return true;
+        }
+        if (rc != RFIDInterface::TAG_NOT_PRESENT) {
+            err = "write_failed";
+            xibalba::audio::error();
+            return false;
+        }
+        vTaskDelay(pdMS_TO_TICKS(120));
+    }
+    err = "tag_timeout";
+    return false;
+}
+
+#else // TEH_NFC_HEADLESS
+
+bool reader_start(JsonObjectConst, String &err) {
+    err = "nfc_headless_unavailable";
+    return false;
+}
+void reader_stop() {}
+void fill_status(JsonObject data) {
+    data["running"] = false;
+    data["ready"] = false;
+    data["state"] = "unavailable";
+}
+bool read_once(JsonObject, int) { return false; }
+bool write_ndef_text(const String &, int, String &err) {
+    err = "nfc_headless_unavailable";
+    return false;
+}
+
+#endif
+
+} // namespace teh_nfc
