diff --git a/src/core/time_sync.cpp b/src/core/time_sync.cpp
new file mode 100644
index 0000000..10abf19
--- /dev/null
+++ b/src/core/time_sync.cpp
@@ -0,0 +1,64 @@
+#include "time_sync.h"
+
+#include <globals.h>
+#include <sys/time.h>
+
+namespace xibalba {
+namespace time_sync {
+
+static int64_t s_offset_ms = 0; // epoch_ms - millis()
+static bool s_synced = false;
+
+void begin() {
+    s_offset_ms = 0;
+    s_synced = false;
+}
+
+int64_t applyAndroidTime(uint64_t androidEpochMs) {
+    uint32_t nowMono = millis();
+    s_offset_ms = (int64_t)androidEpochMs - (int64_t)nowMono;
+    s_synced = true;
+
+    // Fijar reloj de sistema para que logs/SD usen hora real
+    struct timeval tv;
+    tv.tv_sec = (time_t)(androidEpochMs / 1000ULL);
+    tv.tv_usec = (suseconds_t)((androidEpochMs % 1000ULL) * 1000ULL);
+    settimeofday(&tv, nullptr);
+
+#if defined(HAS_RTC)
+#if defined(HAS_RTC_PCF85063A) || defined(HAS_RTC_BM8563A) || defined(HAS_RTC_BM8563)
+    // RTC hardware: persistir para sobrevivir a resets sin batería del SoC
+    struct tm *t = gmtime((const time_t *)&tv.tv_sec);
+    if (t) {
+        _time.Hours = t->tm_hour;
+        _time.Minutes = t->tm_min;
+        _time.Seconds = t->tm_sec;
+        _date.Date = t->tm_mday;
+        _date.Month = t->tm_mon + 1;
+        _date.Year = t->tm_year + 1900;
+        _rtc.SetTime(&_time);
+        _rtc.SetDate(&_date);
+    }
+#endif
+#else
+    // RTC por software (ESP32Time) — reflejar para la UI del dispositivo
+    rtc.setTime(tv.tv_sec);
+    clock_set = true;
+#endif
+
+    Serial.printf("[TIME-SYNC] Reloj fijado a %llu ms epoch (offset %lld ms)\n",
+                  (unsigned long long)androidEpochMs, (long long)s_offset_ms);
+    return s_offset_ms;
+}
+
+bool isSynced() { return s_synced; }
+
+int64_t offsetMs() { return s_offset_ms; }
+
+uint64_t eventTimestampMs() {
+    if (!s_synced) return (uint64_t)millis();
+    return (uint64_t)((int64_t)millis() + s_offset_ms);
+}
+
+} // namespace time_sync
+} // namespace xibalba
diff --git a/src/core/time_sync.h b/src/core/time_sync.h
new file mode 100644
index 0000000..798921a
--- /dev/null
+++ b/src/core/time_sync.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <Arduino.h>
+
+/**
+ * Time Sync — sincronización de reloj Android ↔ Xibalba (TEH-Link v3).
+ *
+ * El T-Embed CC1101 Plus no tiene GPS ni RTC con batería dedicada en todos los
+ * lotes; el reloj se pierde tras deep-sleep/reset. Android aporta la hora real:
+ * EmbedSuite envía `time_sync` con su timestamp y el firmware fija el reloj del
+ * sistema (settimeofday + ESP32Time rtc) y guarda el offset monotónico para
+ * estampar eventos RF/NFC con la hora de pared de Android.
+ */
+namespace xibalba {
+namespace time_sync {
+
+/** Inicializa el módulo (offset 0 = sin sincronizar). */
+void begin();
+
+/**
+ * Recibe el timestamp de Android en ms Unix epoch y fija el reloj local.
+ * Devuelve el offset aplicado (ms) entre reloj monotónico y hora de pared.
+ */
+int64_t applyAndroidTime(uint64_t androidEpochMs);
+
+/** true si el reloj se sincronizó con Android al menos una vez desde el boot. */
+bool isSynced();
+
+/** Offset monotónico→epoch en ms (0 si no sincronizado). */
+int64_t offsetMs();
+
+/** Timestamp de pared (ms epoch) para eventos; cae a millis() si no hay sync. */
+uint64_t eventTimestampMs();
+
+} // namespace time_sync
+} // namespace xibalba
