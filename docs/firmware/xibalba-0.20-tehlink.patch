+#include "audio_feedback.h"
+
+#include "modules/others/audio.h"
+
+namespace xibalba {
+namespace audio {
+
+void begin() {}
+
+void beep(uint16_t freqHz, uint16_t durationMs) {
+    if (freqHz == 0) return;
+    if (freqHz > 8000) freqHz = 8000; // límite seguro NS4168
+    _tone(freqHz, durationMs);
+}
+
+void stop() { _tone(0, 0); }
+
+void ok() { beep(1200, 80); }
+
+void error() {
+    beep(300, 120);
+    delay(140);
+    beep(300, 120);
+}
+
+void cardFound() { beep(1000, 100); }
+
+void packetFound() { beep(800, 50); }
+
+void scanDone() { beep(1200, 200); }
+
+} // namespace audio
+} // namespace xibalba
