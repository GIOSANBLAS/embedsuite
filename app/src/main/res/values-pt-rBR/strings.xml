    <string name="onboard_connect_title">CONECTAR T-EMBED</string>
    <string name="onboard_connect_body">Conecte o T-Embed CC1101 Plus via USB OTG.\nO app usa TEH-Link (firmware Xibalba) para controle total do device.\nLong-press no botão lateral (GPIO6) antes do primeiro pairing.\n\nWiFi/BLE: funções do telefone; OTA Xibalba sempre via USB.</string>
    <string name="onboard_capture_title">CAPTURAR SINAL</string>
    <string name="onboard_capture_body">Vá em RF → CAPTURAR RAW.\nO CC1101 escutará 433.92 MHz.\nOs sinais são salvos com GPS se a localização estiver ativa.</string>
    <string name="onboard_library_title">BIBLIOTECA &amp; REPLAY</string>
    <string name="onboard_library_body">Todos os sinais vão para a biblioteca.\nVocê pode retransmitir, exportar .sub\ne comparar protocolos decodificados.</string>
    <string name="onboard_legal_title">USO LEGAL</string>
    <string name="onboard_legal_body">EMBED SUITE é para pesquisa autorizada.\nVocê é responsável pelo cumprimento das leis locais.\nNão interferir em comunicações alheias nem retransmitir sem permissão.\nWardriving e TX RF podem ser regulados no seu país.</string>
    <string name="onboard_legal_accept">Aceito a responsabilidade legal pelo uso de RF, WiFi/BLE e GPS</string>
    <string name="onboard_next">PRÓXIMO</string>
    <string name="onboard_start">COMEÇAR</string>
    <string name="wireless_war_legal_title">WAR-DRIVE — aviso legal</string>
    <string name="wireless_war_legal_body">O escaneamento WiFi/BLE com GPS guarda redes e localização no telefone. Use apenas em ambientes autorizados. Não é um ataque; você é responsável pelo cumprimento local.</string>
    <string name="wireless_war_legal_accept">Ativar WAR-DRIVE</string>

