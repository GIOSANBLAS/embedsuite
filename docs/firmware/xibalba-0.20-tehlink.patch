+#pragma once
+
+#include <Arduino.h>
+#include <ArduinoJson.h>
+
+/**
+ * TEH-RF — control remoto CC1101 para EmbedSuite (TEH-Link v3).
+ *
+ * Dos plugins lógicos (despachados desde teh_link.cpp):
+ *  - rf_scanner: barrido RSSI headless (freq_start/freq_end/step/threshold)
+ *    con streaming de eventos `rf.scan.sample` hacia la app (mapa RF+GPS).
+ *  - rf_jammer: jammer headless (continuous/burst) con cutoff de seguridad.
+ *
+ * El CC1101 es un recurso exclusivo: scanner, jammer y la captura legacy se
+ * serializan con teh_rf_busy().
+ */
+namespace teh_rf {
+
+// ---- Scanner ----
+bool scan_start(JsonObjectConst params, String &err);
+void scan_stop();
+void scan_fill_status(JsonObject data);
+
+// ---- Jammer ----
+bool jammer_start(JsonObjectConst params, String &err);
+void jammer_stop();
+void jammer_fill_status(JsonObject data);
+
+/** true si scanner o jammer tienen el CC1101 ocupado. */
+bool busy();
+
+} // namespace teh_rf
diff --git a/src/core/teh_link/teh_storage.cpp b/src/core/teh_link/teh_storage.cpp
new file mode 100644
index 0000000..959d491
--- /dev/null
+++ b/src/core/teh_link/teh_storage.cpp
@@ -0,0 +1,106 @@
+#include "teh_storage.h"
+
+#include "core/sd_functions.h"
+#include <SD.h>
+#include <globals.h>
+#include <mbedtls/base64.h>
+#include <memory>
+
+namespace teh_storage {
+
+static const char *SESSION_DIR = "/embedsuite";
+static const size_t MAX_SAVE_BYTES = 256 * 1024; // 256 KB por llamada
+static const int MAX_LIST_ENTRIES = 64;
+
+bool mount(String &err) {
+    if (sdcardMounted) return true;
+    if (setupSdCard()) return true;
+    err = "sd_mount_failed";
+    return false;
+}
+
+void fill_status(JsonObject data) {
+    data["mounted"] = (bool)sdcardMounted;
+    data["state"] = sdcardMounted ? "ready" : "missing";
+    if (sdcardMounted) {
+        data["total_bytes"] = (uint64_t)SD.totalBytes();
+        data["used_bytes"] = (uint64_t)SD.usedBytes();
+    }
+}
+
+void list_dir(const String &path, JsonObject data) {
+    data["mounted"] = (bool)sdcardMounted;
+    data["path"] = path;
+    JsonArray files = data["files"].to<JsonArray>();
+    if (!sdcardMounted) return;
+
+    File dir = SD.open(path.length() ? path : "/");
+    if (!dir || !dir.isDirectory()) {
+        if (dir) dir.close();
+        data["error"] = "not_a_directory";
+        return;
+    }
+    int count = 0;
+    for (File f = dir.openNextFile(); f && count < MAX_LIST_ENTRIES; f = dir.openNextFile()) {
+        JsonObject o = files.add<JsonObject>();
+        o["name"] = String(f.name());
+        o["dir"] = f.isDirectory();
+        o["size"] = (uint32_t)f.size();
+        f.close();
+        count++;
+    }
+    dir.close();
+    data["count"] = count;
+    data["truncated"] = count >= MAX_LIST_ENTRIES;
+}
+
+bool save_file(const String &filename, const String &dataB64, JsonObject data, String &err) {
+    if (!sdcardMounted) {
+        err = "sd_not_mounted";
+        return false;
+    }
+    // Sanitizar: solo nombre de archivo, sin rutas
+    if (filename.length() == 0 || filename.length() > 64 || filename.indexOf('/') >= 0 ||
+        filename.indexOf("..") >= 0) {
+        err = "invalid_filename";
+        return false;
+    }
+
+    size_t olen = 0;
+    mbedtls_base64_decode(nullptr, 0, &olen, (const uint8_t *)dataB64.c_str(), dataB64.length());
+    if (olen == 0 || olen > MAX_SAVE_BYTES) {
+        err = "invalid_size";
+        return false;
+    }
+    std::unique_ptr<uint8_t[]> buf(new (std::nothrow) uint8_t[olen + 1]);
+    if (!buf) {
+        err = "out_of_memory";
+        return false;
+    }
+    if (mbedtls_base64_decode(
+            buf.get(), olen + 1, &olen, (const uint8_t *)dataB64.c_str(), dataB64.length()
+        ) != 0) {
+        err = "b64_error";
+        return false;
+    }
+
+    if (!SD.exists(SESSION_DIR)) SD.mkdir(SESSION_DIR);
+    String full = String(SESSION_DIR) + "/" + filename;
+    File f = SD.open(full, FILE_WRITE);
+    if (!f) {
+        err = "open_failed";
+        return false;
+    }
+    size_t wrote = f.write(buf.get(), olen);
+    f.close();
+    if (wrote != olen) {
+        err = "write_failed";
+        return false;
+    }
+
+    data["path"] = full;
+    data["bytes"] = (uint32_t)olen;
+    return true;
+}
+
+} // namespace teh_storage
