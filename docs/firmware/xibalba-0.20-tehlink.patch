+#include "language.h"
+
+#include <Preferences.h>
+
+namespace xibalba {
+namespace lang {
+
+static Lang s_lang = Lang::ES;
+
+// Sin acentos en las cadenas ES: limitación de las fuentes TFT del Bruce base.
+static const char *const STRINGS_ES[] = {
+    "Xibalba listo. Esperando comandos...", // Ready
+    "Acerca una tarjeta NFC",               // WaitingCard
+    "Tarjeta detectada",                    // CardDetected
+    "Escaneando frecuencias",               // Scanning
+    "Jammer activo",                        // JammerActive
+    "SD montada",                           // SdReady
+    "SD no detectada",                      // SdMissing
+    "Error de operacion",                   // ErrorGeneric
+};
+
+static const char *const STRINGS_EN[] = {
+    "Xibalba ready. Waiting for commands...", // Ready
+    "Bring an NFC card close",                // WaitingCard
+    "Card detected",                          // CardDetected
+    "Scanning frequencies",                   // Scanning
+    "Jammer active",                          // JammerActive
+    "SD card mounted",                        // SdReady
+    "SD card not detected",                   // SdMissing
+    "Operation error",                        // ErrorGeneric
+};
+
+void begin() {
+    Preferences prefs;
+    prefs.begin("xibalba", true);
+    String tag = prefs.getString("lang", "es");
+    prefs.end();
+    s_lang = (tag == "en") ? Lang::EN : Lang::ES;
+}
+
+Lang current() { return s_lang; }
+
+const char *currentTag() { return s_lang == Lang::EN ? "en" : "es"; }
+
+bool setByTag(const String &tag) {
+    if (tag != "es" && tag != "en") return false;
+    s_lang = (tag == "en") ? Lang::EN : Lang::ES;
+    Preferences prefs;
+    prefs.begin("xibalba", false);
+    prefs.putString("lang", tag);
+    prefs.end();
+    return true;
+}
+
+const char *str(Key key) {
+    size_t idx = (size_t)key;
+    if (idx >= (size_t)Key::ErrorGeneric + 1) idx = 0;
+    return (s_lang == Lang::EN) ? STRINGS_EN[idx] : STRINGS_ES[idx];
+}
+
+} // namespace lang
+} // namespace xibalba
